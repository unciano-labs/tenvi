# Application URL
NEXT_PUBLIC_APP_URL=https://tenvi.vercel.app/
APP_URL=https://tenvi.vercel.app/

# Supabase Configuration (both NEXT_PUBLIC_ and non-prefixed are supported)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternatively:
# NEXT_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Website & Role Configuration
WEBSITE_ID=65d4f86e-1829-417a-981f-bc7aad7bc953
DEFAULT_ROLE_ID=your-default-role-id
ADMIN_EMAIL=admin@example.com
ADMIN_PWD=your-admin-password

# Automated Daily Cron Authentication (Vercel Cron / Schedulers)
# Note: Add this same secret in Vercel Project Settings -> Environment Variables so Vercel can authenticate crons
CRON_SECRET=your-random-32-byte-hex-secret

# Email Alerts & SMTP Delivery Engine (Gmail App Password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_NAME="Tenvi Wealth Infrastructure"

# Optional SMS Alerts Gateway (httpSMS)
# HTTPSMS_API_KEY=your-httpsms-api-key
# HTTPSMS_FROM_NUMBER=+639XXXXXXXXX

# Payment Gateway (PayMongo)
PAYMONGO_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_...

# AI Services
GEMINI_API_KEY=your-gemini-api-key

# Bot Protection & Anti-Abuse (Cloudflare Turnstile CAPTCHA)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Testing / Always-Pass Keys (usable in local dev):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
